# Klarert — environment variables
# Copy to .env.local (for local dev) and configure equivalent values in
# Vercel project → Settings → Environment Variables.

# ── Supabase (browser-facing — safe to expose) ───────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Vercel's Supabase integration also writes these — both prefixes accepted.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Contact form endpoint (browser) ──────────────────────────────────────────
# Override where /kontakt and /demo POST. Defaults to /api/contact (Vercel
# Edge function). Leave unset in normal Vercel deployments.
# VITE_CONTACT_FORM_ENDPOINT also accepts VITE_DEMO_FORM_ENDPOINT as fallback
# for legacy code paths.
# VITE_CONTACT_FORM_ENDPOINT=https://your-other-endpoint.example.com/webhook

# ── /api/contact Vercel Edge function (server-only) ──────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# DO NOT commit. DO NOT prefix with VITE_ or NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Klarert <hei@klarert.com>
CONTACT_TO=hei@klarert.com
# DEMO_TO is still read as a fallback alias for CONTACT_TO so deploys that
# rolled out the previous /api/demo function continue to work without changes.
