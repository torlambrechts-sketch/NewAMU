# Klarert — environment variables
# Copy to .env.local (for local dev) and configure equivalent values in
# Vercel project → Settings → Environment Variables.

# ── Supabase (browser-facing — safe to expose) ───────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Vercel's Supabase integration also writes these — both prefixes accepted.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Demo form endpoint (browser) ─────────────────────────────────────────────
# Override where /demo POSTs. Defaults to /api/demo (the Vercel Edge function).
# Leave unset in normal Vercel deployments.
# VITE_DEMO_FORM_ENDPOINT=https://your-other-endpoint.example.com/webhook

# ── /api/demo Vercel Edge function (server-only) ─────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# DO NOT commit. DO NOT prefix with VITE_ or NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Klarert <hei@klarert.com>
DEMO_TO=hei@klarert.com
